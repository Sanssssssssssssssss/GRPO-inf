{
  "model_id": "${MODEL_DIR}",
  "data_path": "${COMPACT_SFT_DATA_ROOT}/sft/reviewer_train.jsonl",
  "eval_data_path": "${COMPACT_SFT_DATA_ROOT}/sft/reviewer_dev.jsonl",
  "output_root": "${OUTPUT_ROOT}",
  "notes": "CSD3 Gemma4 12B compact-chat SFT format warmup canary. Builds strict top-level EvidenceReviewResult JSON before GRPO.",
  "metadata": {
    "model_name": "google/gemma-4-12B-it",
    "dataset_name": "invoice_reviewer_grpo_strict_evr_720_v1_compact_sft_chat_v1",
    "source_dataset_version": "strict_evr_720_v1",
    "compact_prompt_version": "compact_chat_v1",
    "case_count": 720,
    "train_cases": 576,
    "dev_cases": 72,
    "test_locked_cases": 72,
    "canary": true,
    "max_steps": 20
  },
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "model\\.language_model\\.layers\\.\\d+\\.(?:self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)|mlp\\.(?:gate_proj|up_proj|down_proj))"
  },
  "sft": {
    "model_init_kwargs": {
      "dtype": "bfloat16",
      "attn_implementation": "sdpa"
    },
    "max_steps": 20,
    "learning_rate": 0.00002,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "max_length": 8192,
    "completion_only_loss": true,
    "packing": false,
    "logging_steps": 1,
    "save_steps": 10,
    "save_total_limit": 2,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": true
    }
  }
}
