{
  "model_id": "google/gemma-4-31B-it",
  "data_path": "${DATA_ROOT}/grpo/prompts_train.jsonl",
  "output_root": "outputs",
  "notes": "Colocate/Transformers generation profile for first CSD3 bring-up. Use gemma4_31b_grpo_vllm_server.json when rollout GPUs are available.",
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "model\\.language_model\\.layers\\.\\d+\\.(?:self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)|mlp\\.(?:gate_proj|up_proj|down_proj))"
  },
  "grpo": {
    "num_generations": 4,
    "max_prompt_length": 8192,
    "max_completion_length": 1024,
    "learning_rate": 0.000001,
    "beta": 0.01,
    "loss_type": "dr_grpo",
    "scale_rewards": "batch",
    "temperature": 0.8,
    "top_p": 0.95,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_steps": 1000,
    "logging_steps": 10,
    "save_steps": 100,
    "save_total_limit": 3,
    "use_vllm": false,
    "gradient_checkpointing": true,
    "log_completions": true
  }
}
