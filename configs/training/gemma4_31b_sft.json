{
  "model_id": "google/gemma-4-31B-it",
  "data_path": "${DATA_ROOT}/sft/reviewer_train.jsonl",
  "output_root": "outputs",
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "sft": {
    "num_train_epochs": 1,
    "learning_rate": 0.00002,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_length": 8192,
    "logging_steps": 10,
    "save_steps": 100,
    "save_total_limit": 3,
    "gradient_checkpointing": true
  }
}
