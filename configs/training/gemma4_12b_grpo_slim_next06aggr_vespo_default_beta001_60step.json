{
  "model_id": "${MODEL_DIR}",
  "init_adapter_path": "${INIT_ADAPTER_PATH}",
  "data_path": "${COMPACT_SLIM_DATA_ROOT}/grpo/prompts_train.jsonl",
  "eval_data_path": "${COMPACT_SLIM_DATA_ROOT}/grpo/prompts_dev.jsonl",
  "output_root": "${OUTPUT_ROOT}",
  "notes": "VESPO smooth sequence weighting with token-level IS as required by local TRL.",
  "metadata": {
    "model_name": "google/gemma-4-12B-it",
    "dataset_name": "invoice_reviewer_grpo_strict_evr_720_v1_compact_chat_slim_evr_v1",
    "source_dataset_version": "strict_evr_720_v1",
    "compact_prompt_version": "compact_chat_v1",
    "slim_gold_version": "slim_evr_v1",
    "case_count": 720,
    "train_cases": 576,
    "dev_cases": 72,
    "test_locked_cases": 72,
    "requires_sft_adapter": true,
    "max_completion_length": 1536,
    "gold_completion_tokens_p95": 1039,
    "gold_completion_tokens_max": 1046,
    "max_steps": 60,
    "conservative_run": true,
    "ablation": "vespo_default_beta001_60step",
    "continuation_from": "gemma4_12b_grpo_next06_g8_longlow_bestg8_20260618",
    "mechanism": "vespo_variational_soft_policy",
    "algorithm_wave": "next06_aggressive_wave_20260618",
    "risk_level": "experimental"
  },
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "model\\.language_model\\.layers\\.\\d+\\.(?:self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)|mlp\\.(?:gate_proj|up_proj|down_proj))"
  },
  "grpo": {
    "model_init_kwargs": {
      "dtype": "bfloat16",
      "attn_implementation": "sdpa"
    },
    "chat_template_kwargs": {
      "enable_thinking": false
    },
    "generation_kwargs": {
      "eos_token_id": [
        1,
        106
      ],
      "suppress_tokens": [
        258883,
        258882
      ]
    },
    "num_generations": 8,
    "max_completion_length": 1536,
    "generation_batch_size": 8,
    "learning_rate": 6e-08,
    "beta": 0.001,
    "loss_type": "vespo",
    "scale_rewards": "batch",
    "temperature": 0.6,
    "top_p": 0.92,
    "repetition_penalty": 1.04,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 1,
    "max_steps": 60,
    "logging_steps": 1,
    "save_steps": 15,
    "save_total_limit": 8,
    "use_vllm": false,
    "ds3_gather_for_generation": true,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": true
    },
    "mask_truncated_completions": true,
    "log_completions": true,
    "max_grad_norm": 0.2,
    "importance_sampling_level": "token"
  },
  "local_files_only": true,
  "trl_eos_token_id_for_mask": 106
}
