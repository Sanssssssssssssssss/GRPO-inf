{
  "model_id": "${MODEL_DIR}",
  "data_path": "${COMPACT_DATA_ROOT}/grpo/prompts_train.jsonl",
  "eval_data_path": "${COMPACT_DATA_ROOT}/grpo/prompts_dev.jsonl",
  "output_root": "${OUTPUT_ROOT}",
  "notes": "CSD3 compact-prompt canary for invoice_reviewer_grpo_strict_evr_720_v1. Uses compact prompts built from the same source rows to reduce p50 prompt length from about 4118 to 2143 tokens. Runs three steps with short completions and reentrant gradient checkpointing before any longer run is allowed.",
  "metadata": {
    "dataset_name": "invoice_reviewer_grpo_strict_evr_720_v1_compact_v1",
    "source_dataset_version": "strict_evr_720_v1",
    "compact_prompt_version": "compact_v1",
    "case_count": 720,
    "train_cases": 576,
    "dev_cases": 72,
    "test_locked_cases": 72,
    "canary": true
  },
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "model\\.language_model\\.layers\\.\\d+\\.(?:self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)|mlp\\.(?:gate_proj|up_proj|down_proj))"
  },
  "grpo": {
    "model_init_kwargs": {
      "dtype": "bfloat16",
      "attn_implementation": "sdpa"
    },
    "num_generations": 2,
    "max_completion_length": 64,
    "generation_batch_size": 4,
    "learning_rate": 0.000001,
    "beta": 0.01,
    "loss_type": "dr_grpo",
    "scale_rewards": "batch",
    "temperature": 0.8,
    "top_p": 0.95,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "max_steps": 3,
    "logging_steps": 1,
    "save_steps": 1,
    "save_total_limit": 3,
    "use_vllm": false,
    "ds3_gather_for_generation": false,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": true
    },
    "log_completions": true
  }
}
