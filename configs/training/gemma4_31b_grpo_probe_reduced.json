{
  "model_id": "${MODEL_DIR}",
  "data_path": "examples/tiny_dataset/grpo/prompts_train.jsonl",
  "output_root": "${OUTPUT_ROOT}",
  "notes": "CSD3 reduced 2xA100 Gemma 4 31B GRPO probe after the one-step minimal probe passes.",
  "bf16": true,
  "report_to": "none",
  "lora": {
    "task_type": "CAUSAL_LM",
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "bias": "none",
    "target_modules": "model\\.language_model\\.layers\\.\\d+\\.(?:self_attn\\.(?:q_proj|k_proj|v_proj|o_proj)|mlp\\.(?:gate_proj|up_proj|down_proj))"
  },
  "grpo": {
    "num_generations": 4,
    "max_prompt_length": 4096,
    "max_completion_length": 512,
    "learning_rate": 0.000001,
    "beta": 0.01,
    "loss_type": "dr_grpo",
    "scale_rewards": "batch",
    "temperature": 0.8,
    "top_p": 0.95,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "max_steps": 1,
    "logging_steps": 1,
    "save_steps": 1,
    "save_total_limit": 1,
    "use_vllm": false,
    "gradient_checkpointing": true,
    "log_completions": true
  }
}
