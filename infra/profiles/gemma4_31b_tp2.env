VLLM_MODEL=google/gemma-4-31B-it
SERVED_MODEL_NAME=gemma4-31b-reviewer
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
VLLM_ARGS=--enable-prefix-caching --enable-chunked-prefill --max-num-batched-tokens 8192 --gpu-memory-utilization 0.88
SERVE_COMMAND=vllm serve ${VLLM_MODEL} --served-model-name ${SERVED_MODEL_NAME} --tensor-parallel-size ${TENSOR_PARALLEL_SIZE} --max-model-len ${MAX_MODEL_LEN} ${VLLM_ARGS}
