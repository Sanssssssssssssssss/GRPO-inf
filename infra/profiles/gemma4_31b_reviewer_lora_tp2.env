VLLM_MODEL=google/gemma-4-31B-it
SERVED_MODEL_NAME=gemma4-31b-reviewer-grpo
LORA_NAME=reviewer
LORA_PATH=outputs/runs/<run_id>/adapter
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
VLLM_ARGS=--enable-lora --max-lora-rank 64 --lora-modules ${LORA_NAME}=${LORA_PATH} --enable-prefix-caching --enable-chunked-prefill --gpu-memory-utilization 0.88
SERVE_COMMAND=vllm serve ${VLLM_MODEL} --served-model-name ${SERVED_MODEL_NAME} --tensor-parallel-size ${TENSOR_PARALLEL_SIZE} --max-model-len ${MAX_MODEL_LEN} ${VLLM_ARGS}
