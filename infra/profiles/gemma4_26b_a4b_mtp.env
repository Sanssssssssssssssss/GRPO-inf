VLLM_MODEL=google/gemma-4-26B-A4B-it
SERVED_MODEL_NAME=gemma4-26b-a4b-reviewer-mtp
ASSISTANT_MODEL=google/gemma-4-26B-A4B-it-assistant
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=8192
SPECULATIVE_CONFIG={"method":"mtp","model":"${ASSISTANT_MODEL}","num_speculative_tokens":1}
VLLM_ARGS=--enable-prefix-caching --enable-chunked-prefill --max-num-batched-tokens 8192 --gpu-memory-utilization 0.88 --speculative-config '${SPECULATIVE_CONFIG}'
SERVE_COMMAND=vllm serve ${VLLM_MODEL} --served-model-name ${SERVED_MODEL_NAME} --tensor-parallel-size ${TENSOR_PARALLEL_SIZE} --max-model-len ${MAX_MODEL_LEN} ${VLLM_ARGS}
